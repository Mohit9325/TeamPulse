#:kivy 2.0

# ── Corporate Theme Colors (from original QML) ──
#:set BG_LIGHT        (0.953, 0.957, 0.965, 1)  # #F3F4F6
#:set SURFACE_WHITE   (1.0, 1.0, 1.0, 1)        # #FFFFFF
#:set BRAND_RED       (0.827, 0.184, 0.184, 1)  # #D32F2F
#:set BRAND_RED_LIGHT (1.0, 0.922, 0.933, 1)    # #FFEBEE
#:set TEXT_DARK       (0.122, 0.161, 0.216, 1)  # #1F2937
#:set TEXT_GRAY       (0.42, 0.447, 0.502, 1)   # #6B7280
#:set BORDER_COLOR    (0.898, 0.906, 0.922, 1)  # #E5E7EB
#:set TRANSPARENT     (0, 0, 0, 0)
#:set SUCCESS_COLOR   (0.298, 0.686, 0.314, 1)  # #4CAF50
#:set WARNING_COLOR   (1.0, 0.596, 0.0, 1)      # #FF9800

# ══════════════════════════════════════════════════
# REUSABLE WIDGETS
# ══════════════════════════════════════════════════

<CorporateButton>:
    bg_color: BRAND_RED
    background_normal: ''
    background_color: self.bg_color
    color: SURFACE_WHITE
    font_size: sp(14)
    bold: True
    canvas.before:
        Color:
            rgba: self.bg_color if self.state == 'normal' else (self.bg_color[0]*0.8, self.bg_color[1]*0.8, self.bg_color[2]*0.8, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]

<CorporateTextField@TextInput>:
    background_normal: ''
    background_active: ''
    background_color: SURFACE_WHITE
    foreground_color: TEXT_DARK
    hint_text_color: TEXT_GRAY
    cursor_color: BRAND_RED
    font_size: sp(14)
    padding: [dp(10), dp((self.height - self.line_height) / 2)]
    canvas.after:
        Color:
            rgba: BRAND_RED if self.focus else BORDER_COLOR
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(6))
            width: dp(1)

<Card@BoxLayout>:
    canvas.before:
        Color:
            rgba: SURFACE_WHITE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: BORDER_COLOR
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))
            width: dp(1)

# ══════════════════════════════════════════════════
# WIDGET MODELS
# ══════════════════════════════════════════════════

<MetricCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(110)
    padding: dp(15)
    canvas.before:
        Color:
            rgba: SURFACE_WHITE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(12)]
        Color:
            rgba: BORDER_COLOR
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))
            width: dp(1)
    Label:
        text: root.label_text
        font_size: sp(12)
        color: TEXT_GRAY
        size_hint_y: 0.3
        text_size: self.size
        halign: 'center'
        valign: 'top'
    Label:
        text: root.value_text
        font_size: sp(36)
        bold: True
        color: root.accent
        size_hint_y: 0.7
        text_size: self.size
        halign: 'center'
        valign: 'center'

<EmployeeCard>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(70)
    padding: [dp(15), dp(10)]
    spacing: dp(15)
    canvas.before:
        Color:
            rgba: SURFACE_WHITE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: BORDER_COLOR
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(8))
            width: dp(1)
    Widget:
        size_hint: None, None
        size: dp(12), dp(12)
        pos_hint: {'center_y': 0.5}
        canvas:
            Color:
                rgba: root.status_color()
            Ellipse:
                pos: self.pos
                size: self.size
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: root.emp_name
            font_size: sp(16)
            bold: True
            color: TEXT_DARK
            text_size: self.size
            halign: 'left'
            valign: 'bottom'
        Label:
            text: f"{root.emp_status} • {root.emp_task}" if root.emp_task and root.emp_task != 'None' else root.emp_status
            font_size: sp(12)
            color: TEXT_GRAY
            text_size: self.size
            halign: 'left'
            valign: 'top'
    Label:
        text: root.emp_timer
        font_size: sp(14)
        bold: True
        color: root.status_color()
        size_hint_x: None
        width: dp(70)
        text_size: self.size
        halign: 'right'
        valign: 'center'
    BoxLayout:
        orientation: 'horizontal'
        size_hint_x: None
        width: dp(160)
        spacing: dp(5)
        pos_hint: {'center_y': 0.5}
        CorporateButton:
            text: "Assign"
            font_size: sp(11)
            size_hint_y: None
            height: dp(30)
            pos_hint: {'center_y': 0.5}
            on_release: app.assign_task(root.emp_id)
        CorporateButton:
            text: "Status"
            bg_color: WARNING_COLOR
            font_size: sp(11)
            size_hint_y: None
            height: dp(30)
            pos_hint: {'center_y': 0.5}
            on_release: app.open_force_status_popup(root.emp_id)
        CorporateButton:
            text: "Del"
            bg_color: TEXT_GRAY
            font_size: sp(11)
            size_hint_y: None
            height: dp(30)
            pos_hint: {'center_y': 0.5}
            on_release: app.delete_employee(root.emp_id)

<ActivityItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(50)
    padding: [dp(15), dp(10)]
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: SURFACE_WHITE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
    Label:
        text: root.message
        font_size: sp(13)
        color: TEXT_DARK
        text_size: self.width, None
        shorten: True
        shorten_from: 'right'
        valign: 'center'
    Label:
        text: root.timestamp
        font_size: sp(11)
        color: TEXT_GRAY
        size_hint_x: None
        width: dp(60)
        text_size: self.size
        halign: 'right'
        valign: 'center'

<AssignedTaskItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(80)
    padding: [dp(15), dp(10)]
    spacing: dp(15)
    canvas.before:
        Color:
            rgba: SURFACE_WHITE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: BORDER_COLOR
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(8))
            width: dp(1)
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: root.title
            font_size: sp(16)
            bold: True
            color: TEXT_DARK
            text_size: self.size
            halign: 'left'
            valign: 'bottom'
        Label:
            text: root.description
            font_size: sp(12)
            color: TEXT_GRAY
            text_size: self.size
            halign: 'left'
            valign: 'top'
            shorten: True
    BoxLayout:
        orientation: 'vertical'
        size_hint_x: None
        width: dp(140)
        spacing: dp(4)
        Label:
            text: str(root.allocated_time) + "m"
            font_size: sp(12)
            bold: True
            color: BRAND_RED
            size_hint_y: 0.35
            halign: 'center'
        BoxLayout:
            size_hint_y: 0.65
            spacing: dp(5)
            CorporateButton:
                text: "Edit"
                bg_color: TEXT_GRAY
                font_size: sp(11)
                on_release: app.edit_assigned_task(root.task_id, root.title, root.description, root.allocated_time)
            CorporateButton:
                text: "Start"
                bg_color: SUCCESS_COLOR
                font_size: sp(11)
                on_release: root.start_assigned_task()

<CompletedTaskItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(60)
    padding: [dp(10), dp(5)]
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: SURFACE_WHITE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: BORDER_COLOR
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(8))
            width: dp(1)
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: root.task_title
            font_size: sp(14)
            bold: True
            color: TEXT_DARK
            text_size: self.size
            halign: 'left'
            valign: 'bottom'
        Label:
            text: root.task_date
            font_size: sp(11)
            color: TEXT_GRAY
            text_size: self.size
            halign: 'left'
            valign: 'top'
    Label:
        text: root.task_duration
        font_size: sp(12)
        bold: True
        color: SUCCESS_COLOR
        size_hint_x: None
        width: dp(60)
        text_size: self.size
        halign: 'right'
        valign: 'center'

# ══════════════════════════════════════════════════
# POPUPS
# ══════════════════════════════════════════════════

<CompletionNotesPopup>:
    title: "Complete Task"
    size_hint: (0.9, 0.4)
    auto_dismiss: False
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)
        Label:
            text: "Add Completion Notes:"
            color: TEXT_DARK
            size_hint_y: None
            height: dp(30)
            text_size: self.size
            halign: 'left'
        CorporateTextField:
            id: notes_input
            hint_text: "E.g., Finished review, updated docs..."
            multiline: False
            on_text_validate: root.do_complete(notes_input.text)
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)
            CorporateButton:
                text: "Cancel"
                bg_color: TEXT_GRAY
                on_release: root.dismiss()
            CorporateButton:
                text: "Complete"
                on_release: root.do_complete(notes_input.text)

<AddEmployeePopup>:
    title: "Add Employee"
    size_hint: (0.9, 0.7)
    auto_dismiss: False
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)
        CorporateTextField:
            id: emp_name
            hint_text: "Employee Name (e.g. John Doe)"
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: emp_username.focus = True
        CorporateTextField:
            id: emp_username
            hint_text: "Username (for login)"
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: emp_department.focus = True
        CorporateTextField:
            id: emp_department
            hint_text: "Department"
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: emp_password.focus = True
        CorporateTextField:
            id: emp_password
            hint_text: "Password"
            password: True
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: root.do_add(emp_name.text, emp_username.text, emp_department.text, emp_password.text)
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)
            CorporateButton:
                text: "Cancel"
                bg_color: TEXT_GRAY
                on_release: root.dismiss()
            CorporateButton:
                text: "Add"
                on_release: root.do_add(emp_name.text, emp_username.text, emp_department.text, emp_password.text)

<AssignTaskPopup>:
    title: "Assign Task"
    size_hint: (0.9, 0.6)
    auto_dismiss: False
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)
        CorporateTextField:
            id: task_title
            hint_text: "Task Title"
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: task_desc.focus = True
        CorporateTextField:
            id: task_desc
            hint_text: "Task Description"
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: task_mins.focus = True
        CorporateTextField:
            id: task_mins
            hint_text: "Allocated Minutes"
            input_filter: 'int'
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: root.do_assign(task_title.text, task_desc.text, task_mins.text, task_priority.text)
        Spinner:
            id: task_priority
            text: "Medium"
            values: ["High", "Medium", "Low"]
            size_hint_y: None
            height: dp(40)
            background_color: SURFACE_WHITE
            color: TEXT_DARK
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)
            CorporateButton:
                text: "Cancel"
                bg_color: TEXT_GRAY
                on_release: root.dismiss()
            CorporateButton:
                text: "Assign"
                on_release: root.do_assign(task_title.text, task_desc.text, task_mins.text, task_priority.text)

<EditTaskPopup>:
    title: "Edit Task"
    size_hint: (0.9, 0.6)
    auto_dismiss: False
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)
        CorporateTextField:
            id: task_title
            hint_text: "Task Title"
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: task_desc.focus = True
        CorporateTextField:
            id: task_desc
            hint_text: "Task Description"
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: task_mins.focus = True
        CorporateTextField:
            id: task_mins
            hint_text: "Allocated Minutes"
            input_filter: 'int'
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: root.do_save(task_title.text, task_desc.text, task_mins.text, task_priority.text, task_reassign.text)
        Spinner:
            id: task_priority
            text: "Medium"
            values: ["High", "Medium", "Low"]
            size_hint_y: None
            height: dp(40)
            background_color: SURFACE_WHITE
            color: TEXT_DARK
        Spinner:
            id: task_reassign
            text: "Keep Current"
            values: root.emp_options
            size_hint_y: None
            height: dp(40)
            background_color: SURFACE_WHITE
            color: TEXT_DARK
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)
            CorporateButton:
                text: "Cancel"
                bg_color: TEXT_GRAY
                on_release: root.dismiss()
            CorporateButton:
                text: "Save"
                on_release: root.do_save(task_title.text, task_desc.text, task_mins.text, task_priority.text, task_reassign.text)

<ManagerTaskItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(80)
    padding: [dp(15), dp(10)]
    spacing: dp(15)
    canvas.before:
        Color:
            rgba: SURFACE_WHITE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: BORDER_COLOR
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(8))
            width: dp(1)
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: root.title
            font_size: sp(16)
            bold: True
            color: TEXT_DARK
            text_size: self.size
            halign: 'left'
            valign: 'bottom'
        Label:
            text: f"Emp: {root.emp_name} | {root.status} | {root.allocated_time} mins"
            font_size: sp(13)
            color: TEXT_GRAY
            text_size: self.size
            halign: 'left'
            valign: 'top'
    BoxLayout:
        orientation: 'vertical'
        size_hint_x: None
        width: dp(180)
        spacing: dp(5)
        BoxLayout:
            spacing: dp(5)
            CorporateButton:
                text: "Edit"
                size_hint_y: None
                height: dp(30)
                on_release: app.edit_assigned_task(root.task_id, root.title, root.description, root.allocated_time)
            CorporateButton:
                text: "Done"
                bg_color: SUCCESS_COLOR
                size_hint_y: None
                height: dp(30)
                on_release: app.force_complete_task(root.task_id)
        CorporateButton:
            text: "Del"
            bg_color: BRAND_RED
            size_hint_y: None
            height: dp(30)
            on_release: app.delete_assigned_task_manager(root.task_id)

# ══════════════════════════════════════════════════
# LOGIN SCREEN
# ══════════════════════════════════════════════════

<LoginScreen>:
    canvas.before:
        Color:
            rgba: BG_LIGHT
        Rectangle:
            pos: self.pos
            size: self.size
    
    # Background Watermark
    Image:
        source: "logo.png"
        opacity: 0.15
        size_hint: (None, None)
        size: dp(300), dp(300)
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}

    FloatLayout:
        # Main Login Card
        BoxLayout:
            orientation: 'vertical'
            size_hint: (None, None)
            width: min(dp(350), root.width * 0.9)
            height: dp(450)
            pos_hint: {'center_x': 0.5, 'center_y': 0.5}
            padding: dp(30)
            spacing: dp(20)
            canvas.before:
                Color:
                    rgba: SURFACE_WHITE
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(12)]
                Color:
                    rgba: BORDER_COLOR
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(12))
                    width: dp(1)

            Image:
                source: "logo.png"
                size_hint_y: None
                height: dp(50)

            Label:
                text: "TeamPulse"
                font_size: sp(28)
                bold: True
                color: BRAND_RED
                size_hint_y: None
                height: dp(30)

            Label:
                text: "Please log in to your account"
                font_size: sp(13)
                color: TEXT_GRAY
                size_hint_y: None
                height: dp(20)

            CorporateTextField:
                id: username_input
                hint_text: "Username"
                size_hint_y: None
                height: dp(44)
                multiline: False
                on_text_validate: password_input.focus = True

            CorporateTextField:
                id: password_input
                hint_text: "Password"
                password: True
                size_hint_y: None
                height: dp(44)
                multiline: False
                on_text_validate: root.do_login()

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: dp(30)
                spacing: dp(5)
                CheckBox:
                    id: remember_me
                    size_hint_x: None
                    width: dp(30)
                    color: BRAND_RED
                Label:
                    text: "[color=#1F2937]Remember me[/color]"
                    markup: True
                    font_size: sp(12)
                    text_size: self.size
                    halign: 'left'
                    valign: 'center'
                Button:
                    text: "[u][color=#D32F2F]Forgot Password?[/color][/u]"
                    markup: True
                    font_size: sp(12)
                    background_color: TRANSPARENT
                    text_size: self.size
                    halign: 'right'
                    valign: 'center'
                    on_release: app.open_forgot_password()

            Label:
                text: root.error_text
                color: BRAND_RED
                font_size: sp(13)
                bold: True
                size_hint_y: None
                height: dp(30)
                opacity: 1 if root.error_text else 0

            CorporateButton:
                text: "Log In"
                size_hint_y: None
                height: dp(44)
                on_release: root.do_login()

        # Footer
        BoxLayout:
            orientation: 'horizontal'
            size_hint: (None, None)
            height: dp(30)
            width: dp(200)
            pos_hint: {'center_x': 0.5, 'y': 0.05}
            spacing: dp(8)
            Widget:
                size_hint: None, None
                size: dp(8), dp(8)
                pos_hint: {'center_y': 0.5}
                canvas:
                    Color:
                        rgba: SUCCESS_COLOR
                    Ellipse:
                        pos: self.pos
                        size: self.size
            Label:
                text: "v2.4.0 • Connected to Cloud"
                color: TEXT_GRAY
                font_size: sp(12)


# ══════════════════════════════════════════════════
# EMPLOYEE SCREEN
# ══════════════════════════════════════════════════

<EmployeeScreen>:
    canvas.before:
        Color:
            rgba: BG_LIGHT
        Rectangle:
            pos: self.pos
            size: self.size
            
    Image:
        source: "logo.png"
        opacity: 0.15
        size_hint: (None, None)
        size: dp(300), dp(300)
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}

    BoxLayout:
        orientation: 'vertical'

        # Header ToolBar
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: [dp(10), 0]
            canvas.before:
                Color:
                    rgba: SURFACE_WHITE
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: BORDER_COLOR
                Line:
                    points: [self.x, self.y, self.right, self.y]
                    width: dp(1)
            
            Button:
                text: "Logout"
                color: BRAND_RED
                bold: True
                background_color: TRANSPARENT
                size_hint_x: None
                width: dp(80)
                on_release: app.logout()
            Label:
                text: "Employee Portal"
                color: TEXT_DARK
                bold: True
                font_size: sp(16)
            Widget:
                size_hint_x: None
                width: dp(80)

        # Tab Bar
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Button:
                text: "Dashboard"
                background_color: SURFACE_WHITE
                color: BRAND_RED if root.current_tab == 0 else TEXT_GRAY
                bold: root.current_tab == 0
                on_release: root.current_tab = 0
            Button:
                text: "My Profile"
                background_color: SURFACE_WHITE
                color: BRAND_RED if root.current_tab == 1 else TEXT_GRAY
                bold: root.current_tab == 1
                on_release: root.current_tab = 1

        ScreenManager:
            id: sm
            
            Screen:
                name: 'dashboard'
                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: dp(20)
                        spacing: dp(20)

                        Label:
                            text: root.timer_text
                            font_size: sp(48)
                            bold: True
                            color: BRAND_RED if not root.is_paused else TEXT_GRAY
                            size_hint_y: None
                            height: dp(60)

                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: dp(50)
                            opacity: 1 if root.has_active_task else 0
                            Label:
                                text: "Currently Active Task"
                                font_size: sp(14)
                                bold: True
                                color: TEXT_GRAY
                            Label:
                                text: root.current_task_name
                                font_size: sp(18)
                                bold: True
                                color: TEXT_DARK

                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(44)
                            spacing: dp(10)
                            
                            CorporateButton:
                                text: "Resume Task" if root.is_paused else "Pause Break"
                                bg_color: SUCCESS_COLOR if root.is_paused else WARNING_COLOR
                                disabled: not root.has_active_task
                                opacity: 1 if root.has_active_task else 0
                                on_release: root.resume_task() if root.is_paused else root.pause_task()
                                
                            CorporateButton:
                                text: "End Task"
                                bg_color: BRAND_RED
                                disabled: not root.has_active_task
                                opacity: 1 if root.has_active_task else 0
                                on_release: root.open_end_task_popup()

                        Widget:
                            size_hint_y: None
                            height: dp(20)

                        Label:
                            text: "Manager Task Queue"
                            font_size: sp(20)
                            bold: True
                            color: BRAND_RED
                            size_hint_y: None
                            height: dp(30)
                            text_size: self.size
                            halign: 'left'

                        BoxLayout:
                            id: assigned_tasks_container
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(10)

            Screen:
                name: 'profile'
                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: dp(20)
                        spacing: dp(20)

                        # Profile Header
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: dp(140)
                            spacing: dp(10)
                            Widget:
                                size_hint: None, None
                                size: dp(80), dp(80)
                                pos_hint: {'center_x': 0.5}
                                canvas:
                                    Color:
                                        rgba: BRAND_RED
                                    Ellipse:
                                        pos: self.pos
                                        size: self.size
                            Label:
                                text: root.employee_name
                                font_size: sp(24)
                                bold: True
                                color: TEXT_DARK
                                size_hint_y: None
                                height: dp(30)
                            Label:
                                text: root.employee_id_str + " • " + root.employee_department
                                font_size: sp(14)
                                color: TEXT_GRAY
                                size_hint_y: None
                                height: dp(20)

                        # Analytics Card
                        Card:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: dp(120)
                            padding: dp(15)
                            spacing: dp(10)
                            Label:
                                text: "📊 Productivity Analytics"
                                font_size: sp(14)
                                bold: True
                                color: BRAND_RED
                                text_size: self.size
                                halign: 'left'
                                size_hint_y: None
                                height: dp(20)
                            BoxLayout:
                                orientation: 'horizontal'
                                BoxLayout:
                                    orientation: 'vertical'
                                    Label:
                                        text: "Completed"
                                        font_size: sp(11)
                                        color: TEXT_GRAY
                                    Label:
                                        text: root.completed_count
                                        font_size: sp(16)
                                        bold: True
                                        color: TEXT_DARK
                                BoxLayout:
                                    orientation: 'vertical'
                                    Label:
                                        text: "Avg Time"
                                        font_size: sp(11)
                                        color: TEXT_GRAY
                                    Label:
                                        text: root.avg_time_text
                                        font_size: sp(16)
                                        bold: True
                                        color: TEXT_DARK
                                BoxLayout:
                                    orientation: 'vertical'
                                    Label:
                                        text: "Adherence"
                                        font_size: sp(11)
                                        color: TEXT_GRAY
                                    Label:
                                        text: root.adherence_text
                                        font_size: sp(16)
                                        bold: True
                                        color: SUCCESS_COLOR
                        
                        # Task History
                        Label:
                            text: "📋 Task History"
                            font_size: sp(14)
                            bold: True
                            color: BRAND_RED
                            text_size: self.size
                            halign: 'left'
                            size_hint_y: None
                            height: dp(30)
                        
                        BoxLayout:
                            id: task_history_container
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(10)


# ══════════════════════════════════════════════════
# MANAGER SCREEN
# ══════════════════════════════════════════════════

<ManagerScreen>:
    canvas.before:
        Color:
            rgba: BG_LIGHT
        Rectangle:
            pos: self.pos
            size: self.size
            
    Image:
        source: "logo.png"
        opacity: 0.15
        size_hint: (None, None)
        size: dp(300), dp(300)
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}

    BoxLayout:
        orientation: 'vertical'

        # Header ToolBar
        BoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: [dp(10), 0]
            canvas.before:
                Color:
                    rgba: SURFACE_WHITE
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: BORDER_COLOR
                Line:
                    points: [self.x, self.y, self.right, self.y]
                    width: dp(1)
            
            Button:
                text: "Logout"
                color: BRAND_RED
                bold: True
                background_color: TRANSPARENT
                size_hint_x: None
                width: dp(80)
                on_release: app.logout()
            Label:
                text: "Manager Dashboard"
                color: TEXT_DARK
                bold: True
                font_size: sp(16)
            CorporateButton:
                text: "Add User"
                size_hint_x: None
                width: dp(80)
                size_hint_y: None
                height: dp(32)
                pos_hint: {'center_y': 0.5}
                on_release: app.open_add_user_popup()

        # Tab Bar
        BoxLayout:
            size_hint_y: None
            height: dp(48)
            Button:
                text: "Team Status"
                background_color: SURFACE_WHITE
                color: BRAND_RED if root.current_tab == 0 else TEXT_GRAY
                bold: root.current_tab == 0
                on_release: root.current_tab = 0
            Button:
                text: "Task Management"
                background_color: SURFACE_WHITE
                color: BRAND_RED if root.current_tab == 1 else TEXT_GRAY
                bold: root.current_tab == 1
                on_release: root.current_tab = 1
            Button:
                text: "System Logs"
                background_color: SURFACE_WHITE
                color: BRAND_RED if root.current_tab == 2 else TEXT_GRAY
                bold: root.current_tab == 2
                on_release: root.current_tab = 2
            Button:
                text: "Admin Control"
                background_color: SURFACE_WHITE
                color: BRAND_RED if root.current_tab == 3 else TEXT_GRAY
                bold: root.current_tab == 3
                on_release: root.current_tab = 3

        ScreenManager:
            id: manager_sm
            
            Screen:
                name: 'team_status'
                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: dp(15)
                        spacing: dp(15)

                        # Metrics Row
                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(110)
                            spacing: dp(10)
                            MetricCard:
                                label_text: "Active Now"
                                value_text: str(root.active_count)
                                accent: BRAND_RED
                            MetricCard:
                                label_text: "On Break"
                                value_text: str(root.break_count)
                                accent: WARNING_COLOR
                            MetricCard:
                                label_text: "Completed"
                                value_text: str(root.completed_count)
                                accent: SUCCESS_COLOR

                        Label:
                            text: "Team Members"
                            font_size: sp(16)
                            bold: True
                            color: TEXT_DARK
                            size_hint_y: None
                            height: dp(30)
                            text_size: self.size
                            halign: 'left'

                        BoxLayout:
                            id: employee_list
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(10)

            Screen:
                name: 'task_management'
                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: dp(15)
                        spacing: dp(15)
                        
                        Label:
                            text: "All Assigned Tasks"
                            font_size: sp(16)
                            bold: True
                            color: TEXT_DARK
                            size_hint_y: None
                            height: dp(30)
                            text_size: self.size
                            halign: 'left'

                        BoxLayout:
                            id: manager_assigned_tasks_container
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(10)

            Screen:
                name: 'system_logs'
                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: dp(15)
                        spacing: dp(15)
                        
                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: dp(30)
                            Label:
                                text: "System Logs & Activity Feed"
                                font_size: sp(16)
                                bold: True
                                color: TEXT_DARK
                                text_size: self.size
                                halign: 'left'
                            CorporateButton:
                                text: "Export CSV"
                                size_hint_x: None
                                width: dp(100)
                                on_release: app.export_logs()

                        BoxLayout:
                            id: activity_feed
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(10)

            Screen:
                name: 'admin_control'
                ScrollView:
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        padding: dp(15)
                        spacing: dp(15)
                        Label:
                            text: "User Management"
                            font_size: sp(16)
                            bold: True
                            color: TEXT_DARK
                            size_hint_y: None
                            height: dp(30)
                            text_size: self.size
                            halign: 'left'
                        BoxLayout:
                            id: admin_user_list
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(10)

<ForceStatusPopup>:
    title: "Force Status & Timer"
    size_hint: (0.8, 0.5)
    BoxLayout:
        orientation: 'vertical'
        spacing: dp(10)
        padding: dp(10)
        CorporateButton:
            text: "Active"
            on_release: root.set_status("Active")
        CorporateButton:
            text: "On Break"
            bg_color: WARNING_COLOR
            on_release: root.set_status("On Break")
        CorporateButton:
            text: "Offline"
            bg_color: TEXT_GRAY
            on_release: root.set_status("Offline")
        CorporateButton:
            text: "Reset Timer (00:00:00)"
            bg_color: BRAND_RED
            on_release: root.reset_timer()

<AdminUserItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(60)
    padding: dp(10)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: SURFACE_WHITE
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
    Label:
        text: root.username
        color: TEXT_DARK
        text_size: self.size
        halign: 'left'
        valign: 'center'
    Label:
        text: root.role
        color: TEXT_GRAY
        text_size: self.size
        halign: 'center'
        valign: 'center'
    CorporateButton:
        text: "Delete"
        bg_color: TEXT_GRAY
        size_hint_x: None
        width: dp(80)
        on_release: app.delete_employee(root.emp_id)

<ForgotPasswordPopup>:
    title: "Forgot Password"
    size_hint: (0.9, 0.5)
    auto_dismiss: False
    BoxLayout:
        orientation: 'vertical'
        padding: dp(10)
        spacing: dp(10)
        CorporateTextField:
            id: fp_username
            hint_text: "Username"
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: fp_new_password.focus = True
        CorporateTextField:
            id: fp_new_password
            hint_text: "New Password"
            password: True
            size_hint_y: None
            height: dp(40)
            multiline: False
            on_text_validate: root.do_reset(fp_username.text, fp_new_password.text)
        BoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)
            CorporateButton:
                text: "Cancel"
                bg_color: TEXT_GRAY
                on_release: root.dismiss()
            CorporateButton:
                text: "Reset"
                on_release: root.do_reset(fp_username.text, fp_new_password.text)
